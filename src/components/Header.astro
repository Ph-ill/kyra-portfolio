---
import { siteConfig } from "../config";

const navItems = [
  { label: "What I Do", href: "#what-i-do" },
  { label: "Clients", href: "#clients" },
  { label: "Case Studies", href: "#case-studies" },
  { label: "About", href: "#about" },
  { label: "Contact", href: "#contact" },
  { label: "Resume", href: "/resume.pdf", external: true },
];
---

<header id="header" class="site-header" role="banner">
  <nav class="relative mx-auto flex min-h-[58px] max-w-7xl items-center px-6 py-[3px] lg:px-10" aria-label="Primary navigation">
    <a href="#hero" class="font-display text-[2rem] leading-none tracking-[-0.055em] text-[var(--color-text)] md:text-[2.35rem]">
      {siteConfig.name}
    </a>
    <div class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-6 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link"
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener noreferrer" : undefined}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>
